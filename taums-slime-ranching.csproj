<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>taums_slime_ranching</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableModDeploy>false</EnableModDeploy>
        <EnableModZip>false</EnableModZip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(NuGetPackageRoot)pathoschild.stardew.modbuildconfig\4.4.0\build\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- The junction is a read-only reference tree, never part of the mod build. -->
    <ItemGroup>
        <Compile Remove="decompiled game/**/*.cs" />
    </ItemGroup>

</Project>
